---
import Layout from '../../../layouts/Layout.astro';
import { Bot, ExternalLink } from '@lucide/astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title="J.A.R.V.I.S. Mark I | Projekt" description="Case study projektu J.A.R.V.I.S. Mark I - zaawansowanego asystenta AI z dynamicznym routingiem modeli, który zamienia nieustrukturyzowany tekst na wydarzenia w kalendarzu.">
  
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex-grow w-full flex items-center justify-center py-12">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.5fr] gap-10 lg:gap-16 items-center w-full min-w-0 bg-black/20 backdrop-blur-sm p-6 md:p-10 lg:p-12 rounded-[2rem] border border-white/5">
      
      <!-- Lewa kolumna: Tytuł -->
      <div class="space-y-4 min-w-0 flex flex-col justify-center">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 w-fit">
          <Bot class="h-3.5 w-3.5" />
          <span class="text-2xs font-semibold uppercase tracking-widest">Case Study</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.05] text-transparent bg-clip-text bg-gradient-to-b from-white via-zinc-100 to-zinc-300">
          J.A.R.V.I.S.<br/>Mark I
        </h1>
        <p class="text-zinc-400 text-sm max-w-sm leading-relaxed pt-2">
          Asystent AI konwertujący naturalny, nieustrukturyzowany język na uporządkowane dane w kalendarzu i systemie zadań, wspierany dynamicznym routingiem modeli (Ollama, OpenAI, Anthropic).
        </p>
      </div>

      <!-- Prawa kolumna: Bento Boxy z treścią -->
      <div class="flex flex-col gap-4 sm:gap-6 font-sans min-w-0">
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
          <!-- Box 1: Problem -->
          <div class="bg-zinc-950/50 border border-white/5 rounded-2xl p-6 space-y-3 hover:border-white/10 transition-colors">
            <h2 class="text-xs font-semibold uppercase tracking-wider text-blue-400">Problem</h2>
            <p class="text-sm text-zinc-300 leading-relaxed">
              Zarządzanie czasem wymaga żmudnego przeklikiwania się przez kalendarze i aplikacje do notatek. Szybkie myśli ("w piątek wieczorem obiad z Anną") umykają, jeśli nie zostaną od razu skatalogowane.
            </p>
          </div>

          <!-- Box 2: Rozwiązanie -->
          <div class="bg-zinc-950/50 border border-white/5 rounded-2xl p-6 space-y-3 hover:border-white/10 transition-colors">
            <h2 class="text-xs font-semibold uppercase tracking-wider text-blue-400">Rozwiązanie</h2>
            <p class="text-sm text-zinc-300 leading-relaxed mb-2">Zbudowałem backendowego asystenta w Pythonie:</p>
            <ul class="list-disc pl-4 space-y-1.5 text-xs text-zinc-400">
              <li><strong class="text-blue-300">NLP na JSON</strong> — ekstrakcja czasu, miejsca i intencji z potocznej mowy</li>
              <li><strong class="text-white">Model Routing</strong> — inteligentny dobór modelu (od lokalnej Llama3 po GPT-4) na bazie złożoności zadania</li>
              <li><strong class="text-white">Pamięć Kontekstowa</strong> — rozumienie określeń typu "w przyszłym tygodniu" lub "pojutrze"</li>
            </ul>
          </div>
        </div>

        <!-- Box 3: Podejście i Wnioski -->
        <div class="bg-zinc-950/50 border border-white/5 rounded-2xl p-6 space-y-3 hover:border-white/10 transition-colors">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-blue-400">Podejście i Wnioski</h2>
          <p class="text-sm text-zinc-300 leading-relaxed">
            Ten projekt był dla mnie wejściem w inżynierię promptów i budowanie orkiestratorów AI. Nauczył mnie tworzenia systemów, w których to oprogramowanie decyduje, jakiego LLMa (Cloud vs Local) użyć dla zachowania najlepszego balansu między kosztem, szybkością a precyzją.
          </p>
        </div>

        <!-- Stopka Boxów: Tagi i przycisk -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-2">
          <div class="flex flex-wrap gap-2">
            {['Python', 'LangChain / LLM APIs', 'Ollama', 'Data Extraction'].map(tech => (
              <span class="px-2.5 py-1 text-2xs font-medium rounded-full bg-blue-950/30 text-blue-300 border border-blue-500/20">
                {tech}
              </span>
            ))}
          </div>

          <a href="https://github.com/Lukasz-Szymanski/jarvis-mark-1" target="_blank" rel="noopener noreferrer" class="group relative shrink-0 inline-flex items-center justify-center gap-2 px-6 py-2.5 text-sm font-semibold text-white transition-all duration-300 bg-blue-600/20 border border-blue-500/30 rounded-full hover:bg-blue-500/30 hover:border-blue-400/50 hover:scale-[1.02] overflow-hidden">
            <span class="relative z-10 flex items-center gap-2">Zobacz kod <ExternalLink class="w-3.5 h-3.5" /></span>
            <div class="absolute inset-0 h-full w-full bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:animate-[shimmer_1.5s_infinite]"></div>
          </a>
        </div>

      </div>
    </div>
  </section>
</Layout>

<style>
  @keyframes shimmer {
    100% {
      transform: translateX(100%);
    }
  }
</style>
